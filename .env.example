# --- Database -------------------------------------------------------------
# Leave DATABASE_URL unset to use local PGlite (Postgres in WASM, no server).
# Set it to a Neon / Vercel Postgres connection string for deployed
# environments — PGlite writes to disk, which does not survive serverless.
# DATABASE_URL=postgres://user:pass@host/db

# --- Linear ---------------------------------------------------------------
# A PERSONAL API KEY, not an OAuth token. Create one at:
#   Linear -> Settings -> Security & access -> Personal API keys
# Linear shows the key only once, so copy it whole.
#
# Put the real value in .env.local (gitignored), never in this file.
# LINEAR_API_KEY=lin_api_...
